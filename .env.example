# База данных приложения (PostgreSQL в Docker, см. compose.yaml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/digital_deanery?schema=public"

# Отдельная база для интеграционных тестов Vitest
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/digital_deanery_test?schema=public"

# Better Auth: секрет не короче 32 символов (openssl rand -base64 32)
BETTER_AUTH_SECRET="<сгенерируйте командой openssl rand -base64 32>"

# Публичные адреса приложения
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
