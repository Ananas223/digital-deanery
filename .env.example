# База данных приложения (PostgreSQL в Docker, см. compose.yaml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/digital_deanery?schema=public"

# Отдельная база для интеграционных тестов Vitest
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/digital_deanery_test?schema=public"

# Better Auth: секрет не короче 32 символов (openssl rand -base64 32)
BETTER_AUTH_SECRET="<сгенерируйте командой openssl rand -base64 32>"

# Публичные адреса приложения
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ИИ-помощник (опционально, см. docs/specs/p9-ai-assistant.md)
# Включение панели и маршрута POST /api/ai/chat; при false ядро работает без помощника
AI_ASSISTANT_ENABLED="false"
# Ключ провайдера: только на сервере, не получает префикс NEXT_PUBLIC_
# Провайдер — OpenRouter: https://openrouter.ai/keys
AI_PROVIDER_API_KEY=""
# Идентификатор модели у выбранного провайдера (формат vendor/model)
# Пример для OpenRouter: deepseek/deepseek-v4.1-flash или закреплённая deepseek/deepseek-v4.1-flash-1017
AI_MODEL="deepseek/deepseek-v4.1-flash"
