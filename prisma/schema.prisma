generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  DEAN_EMPLOYEE
}

enum StudyForm {
  BUDGET
  PAID
}

enum LessonType {
  LECTURE
  PRACTICE
  LABORATORY
  SEMINAR
}

enum LessonSubgroup {
  ALL
  FIRST
  SECOND
}

enum LessonChangeType {
  CANCELLATION
  TIME_CHANGE
  ROOM_CHANGE
  TEACHER_CHANGE
  LESSON_REPLACEMENT
}

enum SemesterTerm {
  AUTUMN
  SPRING
}

enum AssessmentType {
  EXAM
  CREDIT
  GRADED_CREDIT
  COURSEWORK
}

enum GradeStatus {
  PASSED
  FAILED
  NOT_GRADED
}

enum RequestStatus {
  NEW
  IN_PROGRESS
  READY
  REJECTED
  CANCELLED
}

enum NotificationCategory {
  DEANERY
  SCHEDULE
  REQUESTS
  DEADLINES
}

enum NotificationPriority {
  NORMAL
  IMPORTANT
}

enum NotificationSource {
  DEANERY
  SCHEDULE_SYSTEM
  REQUESTS_SYSTEM
  ACADEMIC_CALENDAR
}

enum NotificationAudience {
  STUDENT
  GROUP
  FACULTY
}

enum NotificationTarget {
  REQUEST
  LESSON
  SECTION
  NONE
}

// --- Better Auth (сгенерировано CLI 1.7.23, модели проверены вручную) ---

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          Role      @default(STUDENT)
  sessions      Session[]
  accounts      Account[]

  studentProfile StudentProfile?

  assignedRequests      Request[]              @relation("RequestAssignee")
  requestHistoryEntries RequestStatusHistory[] @relation("RequestHistoryAuthor")
  createdNotifications  Notification[]         @relation("NotificationCreatedBy")
  notificationReads     NotificationRead[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// --- Доменные модели этапа 0 ---

model Faculty {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  programs      Program[]
  students      StudentProfile[]
  notifications Notification[]   @relation("NotificationAudienceFaculty")

  @@map("faculty")
}

model Program {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  facultyId String
  faculty   Faculty  @relation(fields: [facultyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groups   Group[]
  students StudentProfile[]

  @@index([facultyId])
  @@map("program")
}

model Group {
  id        String   @id @default(cuid())
  code      String   @unique
  programId String
  program   Program  @relation(fields: [programId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students            StudentProfile[]
  lessons             Lesson[]
  exams               Exam[]
  sessionPublications SessionPublication[]
  notifications       Notification[]       @relation("NotificationAudienceGroup")

  @@index([programId])
  @@map("group")
}

model StudentProfile {
  id            String         @id @default(cuid())
  userId        String         @unique
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentNumber String         @unique
  facultyId     String
  faculty       Faculty        @relation(fields: [facultyId], references: [id])
  programId     String
  program       Program        @relation(fields: [programId], references: [id])
  groupId       String
  group         Group          @relation(fields: [groupId], references: [id])
  course        Int
  studyForm     StudyForm
  subgroup      LessonSubgroup @default(ALL)
  enrolledAt    DateTime
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  grades        Grade[]
  requests      Request[]
  notifications Notification[] @relation("NotificationAudienceStudent")

  @@index([groupId])
  @@index([programId])
  @@map("student_profile")
}

// --- Расписание этапа 2 ---

model Teacher {
  id        String   @id @default(cuid())
  fullName  String
  email     String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  disciplines    Discipline[]   @relation("DisciplineTeacher")
  lessons        Lesson[]       @relation("LessonTeacher")
  changedLessons LessonChange[] @relation("ChangedTeacher")
  exams          Exam[]

  @@map("teacher")
}

model Discipline {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  teacherId String?
  teacher   Teacher? @relation("DisciplineTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessons            Lesson[]       @relation("LessonDiscipline")
  replacementChanges LessonChange[] @relation("ReplacementDiscipline")
  grades             Grade[]
  exams              Exam[]

  @@index([teacherId])
  @@map("discipline")
}

model Building {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rooms Room[]

  @@map("building")
}

model Room {
  id         String   @id @default(cuid())
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id])
  number     String
  name       String?
  capacity   Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lessons        Lesson[]       @relation("LessonRoom")
  changedLessons LessonChange[] @relation("ChangedRoom")
  exams          Exam[]

  @@unique([buildingId, number])
  @@index([buildingId])
  @@map("room")
}

model Lesson {
  id           String         @id @default(cuid())
  groupId      String
  group        Group          @relation(fields: [groupId], references: [id])
  disciplineId String
  discipline   Discipline     @relation("LessonDiscipline", fields: [disciplineId], references: [id])
  teacherId    String
  teacher      Teacher        @relation("LessonTeacher", fields: [teacherId], references: [id])
  roomId       String
  room         Room           @relation("LessonRoom", fields: [roomId], references: [id])
  type         LessonType
  subgroup     LessonSubgroup @default(ALL)
  startsAt     DateTime
  endsAt       DateTime
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  changes LessonChange[]

  @@index([groupId, startsAt])
  @@index([teacherId, startsAt])
  @@index([roomId, startsAt])
  @@index([disciplineId])
  @@map("lesson")
}

model LessonChange {
  id                      String           @id @default(cuid())
  lessonId                String
  lesson                  Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  type                    LessonChangeType
  reason                  String?
  newStartsAt             DateTime?
  newEndsAt               DateTime?
  newRoomId               String?
  newRoom                 Room?            @relation("ChangedRoom", fields: [newRoomId], references: [id], onDelete: SetNull)
  newTeacherId            String?
  newTeacher              Teacher?         @relation("ChangedTeacher", fields: [newTeacherId], references: [id], onDelete: SetNull)
  replacementDisciplineId String?
  replacementDiscipline   Discipline?      @relation("ReplacementDiscipline", fields: [replacementDisciplineId], references: [id], onDelete: SetNull)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  @@index([lessonId, createdAt])
  @@map("lesson_change")
}

// --- Успеваемость этапа 3 ---

model Semester {
  id           String       @id @default(cuid())
  academicYear String
  term         SemesterTerm
  startsAt     DateTime
  endsAt       DateTime
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  grades              Grade[]
  exams               Exam[]
  sessionPublications SessionPublication[]

  @@unique([academicYear, term])
  @@index([startsAt])
  @@map("semester")
}

model Grade {
  id               String         @id @default(cuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  disciplineId     String
  discipline       Discipline     @relation(fields: [disciplineId], references: [id])
  semesterId       String
  semester         Semester       @relation(fields: [semesterId], references: [id])
  assessmentType   AssessmentType
  credits          Int
  score            Int?
  status           GradeStatus    @default(NOT_GRADED)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([studentProfileId, disciplineId, semesterId])
  @@index([studentProfileId, semesterId])
  @@index([disciplineId])
  @@map("grade")
}

model SessionPublication {
  semesterId  String
  semester    Semester  @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  groupId     String
  group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  expectedAt  DateTime?
  publishedAt DateTime?

  @@id([semesterId, groupId])
  @@map("session_publication")
}

model Exam {
  id               String         @id @default(cuid())
  groupId          String
  group            Group          @relation(fields: [groupId], references: [id])
  disciplineId     String
  discipline       Discipline     @relation(fields: [disciplineId], references: [id])
  semesterId       String
  semester         Semester       @relation(fields: [semesterId], references: [id])
  assessmentType   AssessmentType
  startsAt         DateTime
  endsAt           DateTime
  previousStartsAt DateTime?
  roomId           String?
  room             Room?          @relation(fields: [roomId], references: [id], onDelete: SetNull)
  teacherId        String?
  teacher          Teacher?       @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([groupId, disciplineId, semesterId])
  @@index([groupId, startsAt])
  @@index([semesterId, startsAt])
  @@index([disciplineId])
  @@map("exam")
}

// --- Заявки и уведомления этапа 4 ---

model RequestType {
  id             String   @id @default(cuid())
  code           String   @unique
  title          String
  description    String
  processingDays Int
  isActive       Boolean  @default(true)
  sortOrder      Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  requests Request[]

  @@map("request_type")
}

model Request {
  id              String         @id @default(cuid())
  number          String         @unique
  studentId       String
  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  typeId          String
  type            RequestType    @relation(fields: [typeId], references: [id])
  status          RequestStatus  @default(NEW)
  payload         Json
  clientRequestId String?
  verifyCode      String?        @unique
  dueAt           DateTime?
  rejectionReason String?
  assignedToId    String?
  assignedTo      User?          @relation("RequestAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  history RequestStatusHistory[]

  @@unique([studentId, clientRequestId])
  @@index([studentId, createdAt])
  @@index([status, createdAt])
  @@index([typeId])
  @@map("request")
}

model RequestStatusHistory {
  id          String         @id @default(cuid())
  requestId   String
  request     Request        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fromStatus  RequestStatus?
  toStatus    RequestStatus
  comment     String?
  changedById String?
  changedBy   User?          @relation("RequestHistoryAuthor", fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())

  @@index([requestId, createdAt])
  @@map("request_status_history")
}

model RequestNumberSequence {
  year       Int @id
  lastNumber Int @default(0)

  @@map("request_number_sequence")
}

model Notification {
  id                String               @id @default(cuid())
  category          NotificationCategory
  source            NotificationSource?
  priority          NotificationPriority @default(NORMAL)
  title             String
  body              String
  audienceType      NotificationAudience
  audienceStudentId String?
  audienceStudent   StudentProfile?      @relation("NotificationAudienceStudent", fields: [audienceStudentId], references: [id], onDelete: SetNull)
  audienceGroupId   String?
  audienceGroup     Group?               @relation("NotificationAudienceGroup", fields: [audienceGroupId], references: [id], onDelete: SetNull)
  audienceFacultyId String?
  audienceFaculty   Faculty?             @relation("NotificationAudienceFaculty", fields: [audienceFacultyId], references: [id], onDelete: SetNull)
  targetType        NotificationTarget   @default(NONE)
  targetId          String?
  dedupeKey         String?              @unique
  publishedAt       DateTime
  expiresAt         DateTime?
  createdById       String?
  createdBy         User?                @relation("NotificationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  reads NotificationRead[]

  @@index([audienceStudentId, publishedAt])
  @@index([audienceGroupId, publishedAt])
  @@index([audienceType, publishedAt])
  @@index([category, publishedAt])
  @@index([targetType, targetId])
  @@map("notification")
}

/// Отметка о прочтении персональна: групповое уведомление читают независимо.
model NotificationRead {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([notificationId, userId])
  @@index([userId, readAt])
  @@map("notification_read")
}
