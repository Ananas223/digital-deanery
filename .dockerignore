# Контекст сборки Docker-образа (см. Dockerfile).
# Всё, что пересоздаётся внутри образа или не нужно рантайму, исключаем.

# Зависимости и артефакты сборки
node_modules
.next
out
build
coverage

# Окружение и секреты: в образ не попадают ни реальные, ни локальные файлы
.env
.env.*

# Тесты, отчёты и браузерные профили
playwright-report
test-results
blob-report
.auth
*.log

# Документация, служебные материалы и конфигурация инструментов
